<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {%- comment -%} Site override: on Home, show every item from the last six months (183 days
          before the build), and at least `announcements.limit` items when there are fewer. {%- endcomment -%}
        {% assign news_cutoff = site.time | date: '%s' | minus: 15811200 %}
        {% for item in news %}
          {% assign item_time = item.date | date: '%s' | plus: 0 %}
          {% if forloop.index > news_limit %}
            {% unless include.limit and item_time >= news_cutoff %}{% break %}{% endunless %}
          {% endif %}
          <tr>
            <th scope="row" class="news-date">{{ item.date | date: '%b %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit %}
      <p class="news-more"><a href="{{ '/news/' | relative_url }}">All news &rarr;</a></p>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
